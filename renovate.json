{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.15.0"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": true,
  "assignees": ["little-forest"],
  "packageRules": [
    {
      "description": "Bump the go directive in go.mod to follow Go releases (CI and release workflows read it via go-version-file)",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Pin and update the digest of the distroless base image in Dockerfile",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["gcr.io/distroless/static-debian13"],
      "pinDigests": true
    }
  ]
}
