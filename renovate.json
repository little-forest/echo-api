{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>aquaproj/aqua-renovate-config#2.14.0"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": true,
  "assignees": ["little-forest"],
  "packageRules": [
    {
      "description": "Bump the go directive in go.mod to follow Go releases (CI and release workflows read it via go-version-file)",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
